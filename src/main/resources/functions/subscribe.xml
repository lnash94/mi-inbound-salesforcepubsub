<template xmlns="http://ws.apache.org/ns/synapse" name="subscribe">
    <parameter name="topic_name" description="The 'topic_name' field for grpc request"/>
    <parameter name="replay_preset" description="The 'replay_preset' field for grpc request"/>
    <parameter name="num_requested" description="The 'num_requested' field for grpc request"/>
    <parameter name="replay_id" description="The 'replay_id' field for grpc request"/>
    <parameter name="auth_refresh" description="The 'auth_refresh' field for grpc request"/>
    <parameter name="responseVariable" description="The name of the variable to which the response should be stored."/>
    <parameter name="overwriteBody" description="Replace the Message Body in Message Context with the response of the operation."/>
    <sequence>
    <!-- Possibly an In mediator or other mediators that read the inbound request -->
        <!-- Initiate Connection -->

    <class name="org.wso2.carbon.pubsubconnector.SubscribeMediator">
        <property name="topic_name" expression="$func:topic_name"/>
        <property name="replay_preset" expression="$func:replay_preset"/>
        <property name="num_requested" expression="$func:num_requested"/>
        <property name="replay_id" expression="$func:replay_id"/>
        <property name="auth_refresh" expression="$func:auth_refresh"/>
    </class>
</sequence>
</template>
